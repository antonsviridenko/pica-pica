/* Resources linked into pica-client.exe by windres.
 *
 * The file names below are looked up along the windres include path, which
 * Makefile.am points at both this directory and the matching build directory,
 * since the manifest is generated by configure while the icon is not.
 */

/* The name IDI_ICON1 is not arbitrary: besides being the icon Explorer shows
 * for the executable, it is the one Qt's windows platform plugin loads from
 * the running binary and installs as the window class icon, which is what
 * appears in the title bar, in the task bar and in the Alt+Tab list. */
IDI_ICON1 ICON "picapica.ico"

/* The application manifest, as resource 1 (CREATEPROCESS_MANIFEST_RESOURCE_ID)
 * of type 24 (RT_MANIFEST).  Spelled numerically so that the resource script
 * does not have to include windows.h through the cross compiler. */
1 24 "pica-client.exe.manifest"

/* What the Details tab of the file properties dialog shows.  The two version
 * macros come from the windres command line in Makefile.am:
 * PICA_WINDOWS_VERSION_COMMAS is the four number form configure derives from
 * the package version, which is the only thing the FILEVERSION field accepts,
 * and PICA_WINDOWS_VERSION_STRING is the package version as it is written
 * everywhere else, which the string fields are free to use. */
1 VERSIONINFO
FILEVERSION    PICA_WINDOWS_VERSION_COMMAS
PRODUCTVERSION PICA_WINDOWS_VERSION_COMMAS
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L /* VOS_NT_WINDOWS32 */
FILETYPE       0x1L     /* VFT_APP */
FILESUBTYPE    0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		/* 0409 is US English, 04E4 is code page 1252.  The pair has to
		 * match the Translation value at the bottom, which is what the
		 * property sheet looks the block up by. */
		BLOCK "040904E4"
		BEGIN
			VALUE "CompanyName",      "picapica.im"
			VALUE "FileDescription",  "Pica Pica Messenger"
			VALUE "FileVersion",      PICA_WINDOWS_VERSION_STRING
			VALUE "InternalName",     "pica-client"
			VALUE "LegalCopyright",   "Copyright (c) 2012 - 2026 Anton Sviridenko"
			VALUE "OriginalFilename", "pica-client.exe"
			VALUE "ProductName",      "Pica Pica Messenger"
			VALUE "ProductVersion",   PICA_WINDOWS_VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1252
	END
END
